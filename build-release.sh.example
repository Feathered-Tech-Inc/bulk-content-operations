#!/usr/bin/env bash
set -euo pipefail

if [ -n "$(git status --porcelain)" ]; then
  echo "❌ Error: Working tree is not clean."
  echo "Please commit or stash your changes before releasing the version."
  exit 1
fi

RELEASE_BRANCH=$(git rev-parse --abbrev-ref HEAD)

echo "Switching to main branch and pulling latest changes..."
git checkout main
git pull origin main

# Fill in your own values
APPLE_SIGNING_IDENTITY="Developer ID Application: Monsters Inc. (123ABCDE456)"
NOTARY_PROFILE="MIKE_WAZOWSKI_NOTARY_PROFILE"

NEW_VERSION=$(node -p "require('./package.json').version")
TAG_NAME="v$NEW_VERSION"

# Abort if the tag already exists locally or on origin
if git rev-parse "$TAG_NAME" >/dev/null 2>&1 || git ls-remote --exit-code --tags origin "refs/tags/$TAG_NAME" >/dev/null 2>&1; then
  echo "❌ Error: Tag $TAG_NAME already exists."
  exit 1
fi

# Verify HEAD is the version-bump commit for this release
HEAD_SUBJECT=$(git log -1 --pretty=%s)
if ! printf '%s\n' "$HEAD_SUBJECT" | grep -q "bump version to v$NEW_VERSION"; then
  # Allow GitHub merge-commit flow: HEAD is merge commit, release bump commit is PR head (HEAD^2)
  if ! printf '%s\n' "$HEAD_SUBJECT" | grep -q "^Merge pull request" \
    || ! git rev-parse -q --verify HEAD^2 >/dev/null 2>&1 \
    || ! git log -1 --pretty=%s HEAD^2 | grep -q "bump version to v$NEW_VERSION"; then
    echo "❌ Error: HEAD is not the release bump commit for v$NEW_VERSION."
    echo "Did the release PR merge? Is something else on main after it?"
    exit 1
  fi
fi

echo "Creating and pushing tag $TAG_NAME..."
git tag -a "$TAG_NAME" -m "Release $TAG_NAME"
git push origin "$TAG_NAME"

echo "Starting macOS release build for $TAG_NAME..."
APPLE_SIGNING_IDENTITY="$APPLE_SIGNING_IDENTITY" NOTARY_PROFILE="$NOTARY_PROFILE" pnpm run release:macos

echo "✅ Build complete."

if command -v gh &> /dev/null; then
  echo "GitHub CLI found. Creating GitHub Release..."
  gh release create "$TAG_NAME" src-tauri/target/release/bundle/dmg/*.dmg src-tauri/target/release/bundle/dmg/*.dmg.sha256 \
    --title "Release $TAG_NAME" \
    --verify-tag \
    --generate-notes

  # Append build/traceability metadata to the generated notes
  GENERATED_NOTES=$(gh release view "$TAG_NAME" --json body -q .body)
  NOTES_FILE="src-tauri/target/release/bundle/release-notes.md"
  printf '%s\n\n%s\n' "$GENERATED_NOTES" "$(cat "$NOTES_FILE")" | gh release edit "$TAG_NAME" --notes-file -
  echo "✅ GitHub Release created successfully!"
else
  echo "⚠️ GitHub CLI (gh) not found. Skipping automated release creation."
  echo "➡️ Next step: Go to GitHub and upload the DMG and release notes manually!"
fi

if [[ "$RELEASE_BRANCH" =~ ^release/v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Deleting release branch $RELEASE_BRANCH from origin..."
  git push origin --delete "$RELEASE_BRANCH"

  echo "Deleting local release branch $RELEASE_BRANCH..."
  git branch -D "$RELEASE_BRANCH"
else
  echo "⚠️ Current branch '$RELEASE_BRANCH' does not match release pattern release/v*.*.*. Skipping release branch deletion."
fi

echo "✅ Release flow complete on main."